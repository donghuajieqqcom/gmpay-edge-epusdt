{
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "gmpay-edge-epusdt",
	"main": "src/server-entry.ts",
	"compatibility_date": "2026-07-01",
	"compatibility_flags": ["nodejs_compat"],
	"placement": { "mode": "smart" },
	"observability": { "enabled": true },
	"cache": { "enabled": true },
	"d1_databases": [
		{
			"binding": "DB",
			"database_name": "gmpay-edge-epusdt",
			"migrations_dir": "drizzle","database_id": "1135cc2b-726e-48ff-a74c-37e3115a1a49"
		}
	],
	"r2_buckets": [{ "binding": "FILES", "bucket_name": "gmpay-edge-files-epusdt","preview_bucket_name": "gmpay-edge-files-epusdt" }],
	"kv_namespaces": [
		{ "binding": "CACHE","id": "cb0a974481c54e56a7fea1ac32761213" }
	],
	"send_email": [{ "name": "EMAIL" }],
	"queues": {
		"producers": [
			{ "binding": "WEBHOOK_QUEUE", "queue": "gmpay-edge-webhooks-epusdt" },
			{ "binding": "PAYMENT_QUEUE", "queue": "gmpay-edge-payments-epusdt" }
		],
		"consumers": [
			{
				"queue": "gmpay-edge-webhooks-epusdt",
				"max_batch_size": 10,
				"max_batch_timeout": 1,
				"max_concurrency": 5,
				"max_retries": 8,
				"retry_delay": 15,
				"dead_letter_queue": "gmpay-edge-webhooks-dlq"
			},
			{
				"queue": "gmpay-edge-payments-epusdt",
				"max_batch_size": 10,
				"max_batch_timeout": 1,
				"max_concurrency": 2,
				"max_retries": 5,
				"retry_delay": 15,
				"dead_letter_queue": "gmpay-edge-payments-dlq"
			}
		]
	},
	"triggers": { "crons": ["* * * * *"] }
}
